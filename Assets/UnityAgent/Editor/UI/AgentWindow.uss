/* Cursor-like Agent window — chat-first, low chrome */

.root {
    flex-grow: 1;
    flex-direction: column;
    background-color: #18181b;
    color: #e4e4e7;
    padding: 0;
    font-size: 12px;
}

/* ---- Top bar ---- */
.topbar {
    flex-direction: row;
    align-items: center;
    height: 36px;
    padding: 0 10px;
    background-color: #18181b;
    border-bottom-width: 1px;
    border-bottom-color: #27272a;
}

.brand {
    font-size: 13px;
    -unity-font-style: bold;
    color: #fafafa;
    margin-right: 8px;
}

.model-chip {
    padding: 2px 8px;
    background-color: #27272a;
    border-radius: 6px;
    color: #a1a1aa;
    font-size: 11px;
    max-width: 220px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.topbar-spacer {
    flex-grow: 1;
}

.status-pill {
    padding: 2px 8px;
    margin-right: 6px;
    color: #71717a;
    font-size: 11px;
}

.ghost-btn {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 6px;
    color: #a1a1aa;
    margin-left: 2px;
    padding: 2px 8px;
}

.ghost-btn:hover {
    background-color: #27272a;
    color: #fafafa;
}

.icon-btn {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 6px;
    color: #a1a1aa;
    margin-left: 2px;
    padding: 2px 8px;
    font-size: 13px;
    min-width: 28px;
}

.icon-btn:hover {
    background-color: #27272a;
    color: #fafafa;
}

.danger {
    color: #f87171;
}

.danger:hover {
    background-color: #3f1d1d;
    color: #fecaca;
}

/* ---- Settings ---- */
.settings-panel {
    padding: 10px 12px;
    background-color: #1c1c1f;
    border-bottom-width: 1px;
    border-bottom-color: #27272a;
}

.settings-hidden {
    display: none;
}

.panel-heading {
    font-size: 11px;
    color: #71717a;
    -unity-font-style: bold;
    margin-bottom: 6px;
    letter-spacing: 0.4px;
}

.settings-grid {
    flex-direction: row;
}

.setting-field {
    flex-grow: 1;
    margin-right: 8px;
}

.settings-actions {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.error-label {
    flex-grow: 1;
    margin-left: 10px;
    white-space: normal;
    color: #fca5a5;
    font-size: 11px;
}

/* ---- Body ---- */
.body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 420px;
}

.chat-column {
    flex-grow: 1;
    flex-direction: column;
    padding: 0;
    min-width: 320px;
    background-color: #18181b;
}

.activity-panel {
    width: 300px;
    min-width: 240px;
    max-width: 360px;
    padding: 0;
    background-color: #141416;
    border-left-width: 1px;
    border-left-color: #27272a;
    flex-direction: column;
}

.activity-hidden {
    display: none;
}

.activity-tabs {
    flex-direction: row;
    padding: 6px 8px;
    border-bottom-width: 1px;
    border-bottom-color: #27272a;
}

.tab-btn {
    flex-grow: 1;
    margin: 0 2px;
    padding: 4px 6px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 6px;
    color: #71717a;
    font-size: 11px;
}

.tab-btn:hover {
    background-color: #27272a;
    color: #e4e4e7;
}

.tab-active {
    background-color: #27272a;
    color: #fafafa;
    -unity-font-style: bold;
}

.tab-panel {
    flex-grow: 1;
    padding: 8px;
}

.tab-panel-hidden {
    display: none;
}

.activity-scroll-fill {
    flex-grow: 1;
    min-height: 200px;
}

/* ---- Chat ---- */
.chat-scroll {
    flex-grow: 1;
    padding: 20px 24px 8px 24px;
}

.chat-container {
    flex-direction: column;
    padding-bottom: 16px;
    max-width: 760px;
    align-self: center;
    width: 100%;
}

.chat-empty {
    margin-top: 56px;
    align-self: center;
    max-width: 480px;
    width: 100%;
    padding: 8px;
}

.chat-empty-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: #fafafa;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.chat-empty-sub {
    color: #71717a;
    white-space: normal;
    margin-bottom: 14px;
    -unity-text-align: middle-center;
}

.suggestion {
    margin-bottom: 6px;
    padding: 10px 12px;
    background-color: #1f1f23;
    border-radius: 10px;
    border-width: 1px;
    border-color: #2e2e33;
    color: #d4d4d8;
    white-space: normal;
}

.suggestion:hover {
    background-color: #27272a;
    border-color: #3f3f46;
    color: #fafafa;
}

/* Messages — flat Cursor style */
.msg {
    margin-bottom: 18px;
    padding: 0;
    flex-direction: column;
}

.msg-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.msg-avatar {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    margin-right: 8px;
    background-color: #3f3f46;
}

.msg-avatar-user {
    background-color: #52525b;
}

.msg-avatar-agent {
    background-color: #3f3f46;
    border-width: 1px;
    border-color: #71717a;
}

.msg-avatar-tool {
    background-color: #3f3f46;
}

.msg-avatar-error {
    background-color: #ef4444;
}

.msg-role {
    font-size: 12px;
    -unity-font-style: bold;
    color: #fafafa;
}

.msg-meta {
    margin-left: 8px;
    font-size: 11px;
    color: #52525b;
}

.msg-body {
    margin-left: 24px;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    white-space: normal;
    color: #d4d4d8;
    font-size: 12px;
}

.msg-user .msg-body {
    color: #e4e4e7;
}

.msg-tool {
    margin-bottom: 8px;
}

.msg-tool .msg-header {
    display: none;
}

.msg-tool .msg-body {
    margin-left: 24px;
    padding: 6px 10px;
    background-color: #1f1f23;
    border-radius: 8px;
    border-width: 1px;
    border-color: #2e2e33;
    color: #a1a1aa;
    font-size: 11px;
}

.msg-error .msg-body {
    margin-left: 24px;
    padding: 8px 10px;
    background-color: #2a1515;
    border-radius: 8px;
    border-width: 1px;
    border-color: #7f1d1d;
    color: #fecaca;
}

.msg-streaming .msg-meta {
    color: #84cc16;
}

/* ---- Composer ---- */
.composer {
    margin: 4px 16px 14px 16px;
    padding: 10px 12px 8px 12px;
    background-color: #1f1f23;
    border-radius: 14px;
    border-width: 1px;
    border-color: #2e2e33;
    flex-direction: column;
    max-width: 760px;
    align-self: center;
    width: 100%;
}

.composer-input {
    min-height: 64px;
    max-height: 180px;
    margin: 0;
    padding: 2px 2px 6px 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    font-size: 13px;
    color: #fafafa;
}

.composer-footer {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.mode-field {
    min-width: 96px;
    max-width: 120px;
    margin: 0 8px 0 0;
}

.hint {
    flex-grow: 1;
    color: #52525b;
    font-size: 11px;
}

.composer-actions {
    flex-direction: row;
    align-items: center;
}

.send-btn {
    margin-left: 6px;
    padding: 0;
    width: 28px;
    height: 28px;
    background-color: #fafafa;
    color: #09090b;
    border-radius: 8px;
    border-width: 0;
    -unity-font-style: bold;
    font-size: 14px;
    -unity-text-align: middle-center;
}

.send-btn:hover {
    background-color: #ffffff;
}

.send-btn:disabled {
    background-color: #3f3f46;
    color: #71717a;
}

/* ---- Activity items ---- */
.plan-item {
    margin-bottom: 4px;
    padding: 7px 9px;
    background-color: #1c1c1f;
    border-radius: 8px;
    border-left-width: 2px;
    border-left-color: #3f3f46;
    white-space: normal;
    color: #d4d4d8;
}

.plan-running {
    border-left-color: #eab308;
}

.plan-done {
    border-left-color: #22c55e;
}

.plan-failed {
    border-left-color: #ef4444;
}

.action-item {
    margin-bottom: 4px;
    padding: 5px 7px;
    background-color: #1c1c1f;
    border-radius: 6px;
    white-space: normal;
    color: #a1a1aa;
    font-size: 11px;
}

.diff-label {
    white-space: normal;
    color: #a1a1aa;
    font-size: 11px;
}
